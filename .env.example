# Server-side only. Do not expose these values in browser code.
LLM_BASE_URL=https://api.whatai.cc
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3-pro-preview
# Storyflow OCR / full-book analysis tuning (optional)
# Use a vision-capable model for OCR.
STORYFLOW_OCR_MODEL=gemini-3.1-pro-preview
# Optional fallback when OCR model fails.
STORYFLOW_OCR_FALLBACK_MODEL=gemini-3.1-flash-lite-preview
# OCR pages per request. 1 is slow but stable.
STORYFLOW_OCR_CHUNK_SIZE=1
# Timeouts (ms)
STORYFLOW_OCR_TIMEOUT_MS=240000
STORYFLOW_ANALYZE_TIMEOUT_MS=300000
COS_SECRET_ID=your_cos_secret_id_here
COS_SECRET_KEY=your_cos_secret_key_here
COS_BUCKET=your-cos-bucket
COS_REGION=ap-guangzhou
COS_OBJECT_PREFIX=videos

# Optional. Client-side invite code for registration. Defaults to VIP888 if omitted.
NEXT_PUBLIC_INVITE_CODE=VIP888
