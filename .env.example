# Server-side only. Do not expose these values in browser code.
LLM_BASE_URL=https://api.whatai.cc
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3-pro-preview
# Storyflow OCR / full-book analysis tuning (optional)
# Use a vision-capable model for OCR.
STORYFLOW_OCR_MODEL=gemini-3.1-pro-preview
# Optional fallback when OCR model fails.
STORYFLOW_OCR_FALLBACK_MODEL=gemini-3.1-flash-lite-preview
# OCR pages per request. 1 is slow but stable.
STORYFLOW_OCR_CHUNK_SIZE=1
# Timeouts (ms)
STORYFLOW_OCR_TIMEOUT_MS=240000
STORYFLOW_ANALYZE_TIMEOUT_MS=300000

# Student Storyflow AI coach. Keep all keys server-side only.
# Existing video assessment / Storyflow analysis still uses LLM_* above.

# Optional Doubao vision assistant for current-page screenshots and uploaded page images.
# Must be a vision-capable Ark/Doubao model. Ordinary text models cannot describe images.
DOUBAO_TEXT_IMAGE_API_KEY=your_doubao_text_image_api_key_here
DOUBAO_TEXT_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_TEXT_IMAGE_MODEL=your_doubao_vision_model_here
# Backward-compatible fallback if you only set one Doubao key.
DOUBAO_API_KEY=
# Set to true only if your Volcengine text/image endpoint requires X-Api-Key instead of Bearer auth.
DOUBAO_USE_X_API_KEY=false
# Optional. Disabled by default because ordinary LLM_* text endpoints often cannot process images
# and expired LLM tokens should not block local OCR/rule-based analysis.
STORYFLOW_USE_LLM_VISION_FALLBACK=false

# Optional. Volcengine end-to-end realtime speech requires App ID + Access Token;
# this is separate from the existing Gemini/LLM_* features.
DOUBAO_REALTIME_APP_ID=
DOUBAO_REALTIME_ACCESS_TOKEN=
DOUBAO_REALTIME_RESOURCE_ID=volc.speech.dialog
DOUBAO_REALTIME_APP_KEY=

# Alternative Doubao realtime API-Key mode, if your Volcengine console only provides API Key.
# When DOUBAO_REALTIME_APP_ID is empty, the server will use X-Api-Key auth with these values.
VOLCENGINE_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
DOUBAO_API_KEY=
RTC_RESOURCE_ID=volc.speech.dialog
# For legacy realtime fallback this may be the speech dialog AppKey.
# For RTC Agent primary path, set this to the AI audio/video application AppKey.
RTC_APP_KEY=
DOUBAO_INPUT_MOD=text

# Volcengine AI audio/video agent over RTC rooms. This is the path that can consume veRTC
# free minutes. Keep AppKey, AK, SK server-side only.
RTC_APP_ID=
DOUBAO_AGENT_BOT_ID=
DOUBAO_AGENT_MODEL=doubao-seed-2-0-lite-260215
DOUBAO_AGENT_TTS_SPEAKER=zh_female_yingyujiaoyu_mars_bigtts
DOUBAO_AGENT_TTS_SPEECH_RATE=-4
DOUBAO_AGENT_TTS_LOUDNESS_RATE=0
DOUBAO_AGENT_TTS_PITCH=-2
DOUBAO_AGENT_WELCOME_MESSAGE=
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
# Optional temporary local validation only. If empty, the server generates an RTC room token from
# RTC_APP_ID + RTC_APP_KEY + RoomId + UserId. If set, RoomId/UserId must match this token.
RTC_TEMP_TOKEN=
RTC_TEMP_ROOM_ID=
RTC_TEMP_USER_ID=

COS_SECRET_ID=your_cos_secret_id_here
COS_SECRET_KEY=your_cos_secret_key_here
COS_BUCKET=your-cos-bucket
COS_REGION=ap-guangzhou
COS_OBJECT_PREFIX=videos

# Optional. Client-side invite code for registration. Defaults to VIP888 if omitted.
NEXT_PUBLIC_INVITE_CODE=VIP888

# Required in production. Used to sign the httpOnly login session cookie.
SESSION_SECRET=replace_with_a_long_random_secret

# Optional. Force cookie secure mode: true / false. If omitted, the app auto-detects
# whether the current request is HTTPS.
SESSION_COOKIE_SECURE=
